{
  "parsers": [
    "sarif",
    "codeql"
  ],
  "filename": "scan.sarif",
  "valid": {
    "version": "2.1.0",
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "runs": [
      {
        "tool": {
          "driver": {
            "name": "CodeQL",
            "rules": [
              {
                "id": "py/example",
                "shortDescription": {
                  "text": "Example"
                },
                "defaultConfiguration": {
                  "level": "error"
                },
                "properties": {
                  "security-severity": "9.8",
                  "tags": [
                    "security",
                    "external/cwe/cwe-079"
                  ]
                }
              }
            ]
          }
        },
        "results": [
          {
            "ruleId": "py/example",
            "message": {
              "text": "Example"
            },
            "locations": [
              {
                "physicalLocation": {
                  "artifactLocation": {
                    "uri": "app.py"
                  },
                  "region": {
                    "startLine": 12
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "clean": {
    "version": "2.1.0",
    "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
    "runs": [
      {
        "tool": {
          "driver": {
            "name": "CodeQL",
            "rules": [
              {
                "id": "py/example",
                "shortDescription": {
                  "text": "Example"
                },
                "defaultConfiguration": {
                  "level": "error"
                },
                "properties": {
                  "security-severity": "9.8",
                  "tags": [
                    "security",
                    "external/cwe/cwe-079"
                  ]
                }
              }
            ]
          }
        },
        "results": []
      }
    ]
  },
  "invalid": {
    "runs": [
      {
        "results": []
      }
    ]
  },
  "expected": [
    {
      "source_id": "py/example",
      "severity": "critical",
      "cvss_score": 9.8,
      "file_path": "app.py",
      "line_number": 12,
      "cwe_id": 79
    }
  ]
}
