# ----------------------------
# Required
# ----------------------------
POSTGRES_PASSWORD=changeme
# Full administrative API access. Used only by the server-side frontend proxy.
API_KEY=changeme-generate-with-openssl-rand-hex-32
# Ingestion-only access for scanners. Must be different from API_KEY.
INGEST_API_KEY=changeme-generate-a-second-openssl-rand-hex-32
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=changeme-generate-a-long-random-password

# ----------------------------
# Database (defaults shown)
# ----------------------------
POSTGRES_USER=secops
POSTGRES_DB=secops
DATABASE_URL=postgresql://secops:changeme@localhost:5432/secops

# ----------------------------
# Slack integration (optional)
# ----------------------------
SLACK_WEBHOOK_URL=

# ----------------------------
# Jira integration (optional)
# ----------------------------
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC

# ----------------------------
# CORS (comma-separated origins)
# ----------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ----------------------------
# Import safety
# ----------------------------
MAX_SCAN_BYTES=10485760
# Raw HTTP request cap, enforced before JSON request validation.
MAX_IMPORT_REQUEST_BYTES=12582912
MAX_FINDINGS_PER_IMPORT=10000
# Raw scanner payloads can contain source code and live credentials.
STORE_RAW_SCAN_DATA=false
# Development escape hatch. Never enable in a public environment.
ALLOW_INSECURE_NO_AUTH=false
