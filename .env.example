# ----------------------------
# Required
# ----------------------------
POSTGRES_PASSWORD=
# Full administrative API access. Used only by the server-side frontend proxy.
API_KEY=
# Ingestion-only access for scanners. Must be different from API_KEY.
INGEST_API_KEY=
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
# Exact browser origins allowed to change data. Use HTTPS for a public hostname.
DASHBOARD_ORIGINS=http://localhost:5000
# Keep loopback when using the documented host-side TLS reverse proxy.
DASHBOARD_BIND_ADDRESS=127.0.0.1
# Use the LTS runtime for production. Node 26 is an optional compatibility build.
FRONTEND_NODE_MAJOR=24

# ----------------------------
# Database (defaults shown)
# ----------------------------
POSTGRES_USER=secops
POSTGRES_DB=secops
# Local, non-Compose runs may export DATABASE_URL instead. Compose uses PG*
# variables internally to preserve reserved characters in database passwords.
# DATABASE_URL=sqlite:///./secops.db

# ----------------------------
# Slack integration (optional)
# ----------------------------
SLACK_WEBHOOK_URL=

# ----------------------------
# Jira integration (optional)
# ----------------------------
JIRA_BASE_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@yourorg.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SEC
# Exact issue type name supported by your Jira project's creation screen.
JIRA_ISSUE_TYPE=Bug
# Optional exact Jira priority names. Leave empty to use Jira's project default.
JIRA_PRIORITY_CRITICAL=
JIRA_PRIORITY_HIGH=
JIRA_PRIORITY_MEDIUM=
JIRA_PRIORITY_LOW=
JIRA_PRIORITY_INFO=

# ----------------------------
# CORS (comma-separated origins)
# ----------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
ALLOWED_HOSTS=localhost,127.0.0.1,backend

# ----------------------------
# Import safety
# ----------------------------
MAX_SCAN_BYTES=10485760
# Raw request cap for endpoints other than scan imports.
MAX_REQUEST_BYTES=1048576
# Raw HTTP request cap, enforced before JSON request validation.
MAX_IMPORT_REQUEST_BYTES=12582912
MAX_FINDINGS_PER_IMPORT=10000
IMPORT_TIMEOUT_SECONDS=900
# Raw scanner payloads can contain source code and live credentials.
STORE_RAW_SCAN_DATA=false
# Historical adapters without supported-version fixtures remain disabled.
ALLOW_UNVERIFIED_PARSERS=false
# Background outbox delivery; exhausted jobs remain visible for operator review.
NOTIFICATION_POLL_SECONDS=5
NOTIFICATION_MAX_ATTEMPTS=5
# Development escape hatch. Never enable in a public environment.
ALLOW_INSECURE_NO_AUTH=false
